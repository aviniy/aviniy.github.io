---
import '../styles/personal.css';
import '../styles/personal-nav.css';
import '../styles/social-dock.css';
import '../styles/youtube-player.css';
import '../styles/personal-theme.css';
import { rootUrl } from '../lib/posts.js';
const { title = 'aviniy.exe', description = '그냥 이것저것 하는 사람. 애니 시청은 기본 소양.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(rootUrl('images/aviniy-og.png'), Astro.site);
---
<!doctype html>
<html lang="ko" class="personal-site" data-personal-theme="bocchi">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <script is:inline data-personal-theme-init>
      (() => {
        let theme = 'bocchi';
        try {
          if (localStorage.getItem('aviniy-personal-theme-v1') === 'kurumi') theme = 'kurumi';
        } catch { /* Default theme also works without storage. */ }
        document.documentElement.dataset.personalTheme = theme;
      })();
    </script>
    <meta name="description" content={description}/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical.href}/>
    <meta property="og:image" content={ogImage.href}/>
    <meta property="og:image:width" content="1730"/>
    <meta property="og:image:height" content="909"/>
    <link rel="canonical" href={canonical.href}/>
    <link rel="icon" href={rootUrl('images/ryo-favicon.jpg')} type="image/jpeg"/>
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
