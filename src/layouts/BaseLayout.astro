---
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import '../styles/sidebar.css';
import { url } from '../lib/posts.js';
const { title = "Aviniy's Lab", description = '정보보안, 리눅스, 웹 보안, 워게임 학습 기록', posts = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical.href}/><link rel="canonical" href={canonical.href}/><link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/><title>{title}</title><script is:inline>try{const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}catch{}</script></head><body><a class="skip" href="#main">본문으로 이동</a><header class="mobile-header"><button id="menu-toggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="sidebar">☰</button><a href={url()}>Aviniy's Lab</a></header><Sidebar posts={posts}/><div id="scrim" hidden></div><main id="main" class="main"><div class="content"><slot /></div></main><script is:inline>const menu=document.querySelector('#menu-toggle'),side=document.querySelector('#sidebar'),scrim=document.querySelector('#scrim');function close(){side?.classList.remove('open');menu?.setAttribute('aria-expanded','false');scrim.hidden=true}menu?.addEventListener('click',()=>{const open=side.classList.toggle('open');menu.setAttribute('aria-expanded',String(open));scrim.hidden=!open});scrim?.addEventListener('click',close);document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});document.querySelector('#theme-toggle')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('theme',next)});</script></body></html>
