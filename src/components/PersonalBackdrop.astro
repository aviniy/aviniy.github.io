---
import { getImage } from 'astro:assets';
import kurumiArtwork from '../assets/kurumi-clock.jpg';
const desktop = await getImage({ src: kurumiArtwork, width: 2560, format: 'webp', quality: 90 });
const mobile = await getImage({ src: kurumiArtwork, width: 1280, format: 'webp', quality: 88 });
---
<!-- Fixed artwork crossfades independently of content and the YouTube iframe. -->
<div class="personal-backdrop" aria-hidden="true">
  <div class="bocchi-backdrop"></div>
  <div class="kurumi-backdrop">
    <picture>
      <source media="(max-width: 850px)" srcset={mobile.src} />
      <img src={desktop.src} width="2560" height="1600" alt="" decoding="async" />
    </picture>
  </div>
</div>
