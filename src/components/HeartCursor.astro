<div class="heart-cursor-layer" aria-hidden="true" data-heart-cursor></div>

<style>
  .heart-cursor-layer { position: fixed; inset: 0; z-index: 9999; overflow: hidden; pointer-events: none; }
  :global(.cursor-particle) {
    position: fixed; left: 0; top: 0; color: var(--color); font-size: var(--size);
    line-height: 1; pointer-events: none; user-select: none; will-change: transform, opacity;
    animation: cursor-float var(--duration) cubic-bezier(.18,.65,.35,1) forwards;
    filter: drop-shadow(0 1px 1px rgb(30 20 32 / 18%));
  }
  :global(.cursor-particle[data-kind="petal"]) {
    width: var(--size); height: calc(var(--size) * .68);
    border-radius: 85% 12% 70% 28%; background: var(--color);
    filter: none;
  }
  :global(.cursor-particle[data-kind="clock"]) {
    width: var(--size); height: var(--size);
    border: 1px solid currentColor; border-radius: 50%; filter: none;
  }
  :global(.cursor-particle[data-kind="clock"]::before),
  :global(.cursor-particle[data-kind="clock"]::after) {
    content: ''; position: absolute; left: 50%; top: 50%;
    width: 1px; height: 32%; background: currentColor;
    transform-origin: center top;
  }
  :global(.cursor-particle[data-kind="clock"]::before) { transform: rotate(180deg); }
  :global(.cursor-particle[data-kind="clock"]::after) { height: 25%; transform: rotate(-55deg); }
  @keyframes cursor-float {
    0% { opacity: 0; transform: translate(-50%,-50%) rotate(var(--rotation)) scale(.45); }
    16% { opacity: var(--opacity); transform: translate(calc(-50% + var(--early-dx)),calc(-50% + var(--early-dy))) rotate(var(--rotation)) scale(1); }
    100% { opacity: 0; transform: translate(calc(-50% + var(--dx)),calc(-50% + var(--dy))) rotate(var(--end-rotation)) scale(.58); }
  }
  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) { .heart-cursor-layer { display: none; } }
</style>

<script is:inline>
  (() => {
    const layer = document.querySelector('[data-heart-cursor]');
    if (!layer || layer.dataset.initialized) return;
    layer.dataset.initialized = 'true';
    const pointer = matchMedia('(hover: hover) and (pointer: fine)');
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    const colors = ['#ffb6c9', '#f3c4d8', '#d8c4f5', '#fff'];
    const petalColors = ['#a52a45', '#8c263e', '#6f2035'];
    const particles = new Set();
    const MAX = 85;
    let queued = null, frame = 0, previous = null, lastEmission = 0, lastClock = -Infinity, lastBurst = -Infinity, active = false;
    const random = (min, max) => min + Math.random() * (max - min);

    function create(x, y, vx, vy, burst = false) {
      if (particles.size >= MAX) return;
      const particle = document.createElement('span');
      const choice = Math.random();
      const kurumi = document.documentElement.dataset.personalTheme === 'kurumi';
      const clock = kurumi && choice > .96 && performance.now() - lastClock > 350;
      const petal = kurumi && !clock && choice < .8;
      particle.className = 'cursor-particle';
      particle.dataset.kind = kurumi ? clock ? 'clock' : petal ? 'petal' : 'sparkle' : choice < .69 ? 'heart' : 'sparkle';
      particle.textContent = kurumi ? petal || clock ? '' : '✧' : choice < .69 ? '♥' : choice < .88 ? '✦' : '✧';
      if (clock) lastClock = performance.now();
      const dx = burst ? vx : -vx * random(.14, .32) + random(-20, 20);
      const dy = burst ? vy : -vy * random(.12, .27) + random(14, 38);
      const rotation = random(-30, 30);
      particle.style.left = `${x}px`;
      particle.style.top = `${y}px`;
      const palette = kurumi ? petal ? petalColors : ['#c6a36a', '#d6b77f'] : colors;
      particle.style.setProperty('--color', palette[Math.floor(Math.random() * palette.length)]);
      particle.style.setProperty('--size', `${kurumi ? clock ? random(9, 12) : petal ? random(7, 13) : random(5, 10) : choice < .69 ? random(7, 17) : random(5, 11)}px`);
      particle.style.setProperty('--duration', `${random(burst ? 530 : 670, burst ? 940 : 1100)}ms`);
      particle.style.setProperty('--opacity', (kurumi ? random(.5, .8) : random(.62, .95)).toFixed(2));
      const finalX = Math.max(-100, Math.min(100, dx));
      const finalY = Math.max(-100, Math.min(100, dy));
      particle.style.setProperty('--dx', `${finalX}px`);
      particle.style.setProperty('--dy', `${finalY}px`);
      particle.style.setProperty('--early-dx', `${finalX * .13}px`);
      particle.style.setProperty('--early-dy', `${finalY * .13}px`);
      particle.style.setProperty('--rotation', `${rotation}deg`);
      particle.style.setProperty('--end-rotation', `${rotation + random(-75, 75)}deg`);
      particles.add(particle);
      layer.appendChild(particle);
      particle.addEventListener('animationend', () => { particles.delete(particle); particle.remove(); }, { once: true });
    }
    function flush(now) {
      frame = 0;
      if (!queued || !active) return;
      const { x, y } = queued;
      queued = null;
      if (previous) {
        const elapsed = Math.max(now - previous.time, 16);
        const vx = x - previous.x, vy = y - previous.y;
        const distance = Math.hypot(vx, vy);
        if (distance > 2 && now - lastEmission >= 28) {
          const count = Math.min(4, 1 + Math.floor((distance / elapsed) / .55));
          for (let i = 0; i < count; i++) create(x - vx * i / (count + 1), y - vy * i / (count + 1), vx, vy);
          lastEmission = now;
        }
      }
      previous = { x, y, time: now };
    }
    function onMove(event) {
      if (event.pointerType && event.pointerType !== 'mouse') return;
      queued = { x: event.clientX, y: event.clientY };
      if (!frame) frame = requestAnimationFrame(flush);
    }
    function onClick(event) {
      if (event.pointerType && event.pointerType !== 'mouse') return;
      const now = performance.now();
      if (now - lastBurst < 120) return;
      lastBurst = now;
      for (let i = 0; i < 12; i++) {
        const angle = i * Math.PI / 6 + random(-.16, .16);
        const distance = random(25, 62);
        create(event.clientX, event.clientY, Math.cos(angle) * distance, Math.sin(angle) * distance, true);
      }
    }
    function clear() {
      cancelAnimationFrame(frame); frame = 0; queued = previous = null;
      particles.forEach(particle => particle.remove()); particles.clear();
    }
    function stop() {
      active = false;
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerdown', onClick);
      clear();
    }
    function sync() {
      if (!pointer.matches || motion.matches || document.hidden) { stop(); return; }
      if (active) return;
      active = true;
      document.addEventListener('pointermove', onMove, { passive: true });
      document.addEventListener('pointerdown', onClick, { passive: true });
    }
    pointer.addEventListener('change', sync);
    motion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    document.addEventListener('aviniy:theme-change', clear);
    addEventListener('pagehide', stop);
    addEventListener('pageshow', sync);
    sync();
  })();
</script>
