---
import { categories } from '../config/categories.js';
import { sortCategoryPosts } from '../lib/category-sort.js';
import { postUrl, rootUrl, url } from '../lib/posts.js';
import SidebarNode from './SidebarNode.astro';

const { posts = [] } = Astro.props;
const banditLevels = sortCategoryPosts(posts.filter(post => post.data.category === 'OverTheWire Bandit' && /^Level\s+\d+\b/i.test(post.data.title)), 'OverTheWire Bandit');
const postNodes = list => list.map(post => ({ name: post.data.title, href: postUrl(post), kind: 'post' }));
const miscPosts = posts.filter(post => post.data.category === 'Misc');
const tree = categories.map(group => {
  if (group.name === 'Wargame') return {
    ...group,
    children: group.children.map(child => child === 'OverTheWire Bandit' ? {
      name: child,
      children: postNodes(banditLevels)
    } : child)
  };
  if (group.name === 'Misc') return { ...group, children: postNodes(miscPosts) };
  return group;
});
---
<aside class="sidebar" id="sidebar">
  <div class="brand"><a href={url()}>✳ &nbsp;Aviniy's Lab</a></div>
  <nav aria-label="주 탐색">
    <a class="nav-link" href={url()}>⌂ &nbsp; Home</a>
    <a class="nav-link" href={url('search/')}>⌕ &nbsp; Search</a>
    <div class="nav-heading">LIBRARY</div>
    {tree.map(group => <SidebarNode node={group} posts={posts} depth={0} />)}
    <div class="nav-heading">OTHER</div>
    <a class="nav-link" href={url('about/')}>About</a>
    <a class="nav-link" href={rootUrl()}>Personal Home</a>
    <a class="nav-link" href={rootUrl('admin/')} rel="nofollow">Admin</a>
  </nav>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="테마 전환">◐ &nbsp; 테마 전환</button>
</aside>
<script is:inline>
  try {
    const key = 'lab-sidebar-open';
    const saved = JSON.parse(localStorage.getItem(key) || '{}');
    document.querySelectorAll('#sidebar details[data-category]').forEach(item => {
      if (!item.dataset.active && Object.prototype.hasOwnProperty.call(saved, item.dataset.category)) item.open = saved[item.dataset.category];
      item.addEventListener('toggle', () => {
        saved[item.dataset.category] = item.open;
        localStorage.setItem(key, JSON.stringify(saved));
      });
    });
  } catch {}
</script>
