---
import { categories, categoryName, categoryLabel, categoryDescendants } from '../config/categories.js';
import { url } from '../lib/posts.js';
const { posts = [] } = Astro.props;
const count = node => posts.filter(p => categoryDescendants(node).includes(p.data.category)).length;
---
<aside class="sidebar" id="sidebar"><div class="brand"><a href={url()}>✳ &nbsp;Aviniy's Lab</a></div><nav aria-label="주 탐색"><a class="nav-link" href={url()}>⌂ &nbsp; Home</a><a class="nav-link" href={url('search/')}>⌕ &nbsp; Search</a><div class="nav-heading">LIBRARY</div>{categories.map(group => <div class="nav-group"><a class="nav-link group" href={url(`category/${encodeURIComponent(group.name)}/`)}>{group.name}<span>{count(group)}</span></a>{group.children.map(child => <><a class="nav-link sub" href={url(`category/${encodeURIComponent(categoryName(child))}/`)}>{categoryLabel(child)}<span>{count(child)}</span></a>{typeof child !== 'string' && child.children?.map(grandchild => <a class="nav-link subsub" href={url(`category/${encodeURIComponent(categoryName(grandchild))}/`)}>{categoryLabel(grandchild)}<span>{count(grandchild)}</span></a>)}</>)}</div>)}<div class="nav-heading">OTHER</div><a class="nav-link" href={url('about/')}>About</a></nav><button id="theme-toggle" class="theme-toggle" type="button" aria-label="테마 전환">◐ &nbsp; 테마 전환</button></aside>
