---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { allPosts, postUrl } from '../lib/posts.js';
const posts = await allPosts();
const index = await Promise.all(posts.map(async p => ({title:p.data.title,description:p.data.description,category:p.data.category,tags:p.data.tags,url:postUrl(p),body:p.body.replace(/<[^>]+>/g,' ').slice(0,12000)})));
---
<BaseLayout title="Search · Aviniy's Lab" posts={posts}><div class="eyebrow">SEARCH</div><h1>Search</h1><label for="q">게시글 검색</label><input id="q" type="search" placeholder="제목, 본문, 카테고리, 태그 검색" autocomplete="off"/><p id="search-count" class="muted" aria-live="polite"></p><div id="results" class="post-list"></div><script id="search-data" type="application/json" set:html={JSON.stringify(index).replace(/</g,'\\u003c')}></script><script is:inline>const items=JSON.parse(document.querySelector('#search-data').textContent),input=document.querySelector('#q'),results=document.querySelector('#results'),count=document.querySelector('#search-count');function search(){const q=input.value.trim().toLocaleLowerCase();results.replaceChildren();if(!q){count.textContent='검색어를 입력하세요.';return}const found=items.filter(x=>[x.title,x.description,x.category,...x.tags,x.body].join(' ').toLocaleLowerCase().includes(q));count.textContent=`${found.length}개 결과`;for(const p of found){const a=document.createElement('a');a.className='post-row';a.href=p.url;const strong=document.createElement('strong');strong.textContent='▤  '+p.title;const desc=document.createElement('p');desc.textContent=p.description;const meta=document.createElement('small');meta.textContent=[p.category,...p.tags.map(t=>'#'+t)].join(' · ');a.append(strong,desc,meta);results.append(a)}}input.addEventListener('input',search);search();</script></BaseLayout>
