---
import PersonalLayout from '../layouts/PersonalLayout.astro';
import PersonalNav from '../components/PersonalNav.astro';
import { rootUrl } from '../lib/posts.js';
import '../styles/aboutme.css';
---
<PersonalLayout title="About Me | aviniy.exe" description="aviniy의 소개와 관심사">
  <main class="about-page">
    <PersonalNav />

    <div class="about-wrap">
      <section class="profile" aria-labelledby="about-title">
        <div class="profile-copy">
          <p class="section-index">PROFILE</p>
          <h1 id="about-title">About Me</h1>
          <p class="nickname">aviniy</p>
          <p class="profile-intro">University Freshman<br />he/him · INTP</p>
          <ul class="profile-meta" aria-label="추가 정보">
            <li>대학생</li>
            <li>정보보안 공부 중</li>
          </ul>
        </div>
        <figure class="profile-image">
          <img src={rootUrl('images/kurumi-profile.jpg')} alt="aviniy 프로필 이미지" width="720" height="720" />
        </figure>
      </section>

      <section class="about-section" aria-labelledby="what-i-do">
        <header class="section-heading">
          <span>01</span>
          <h2 id="what-i-do">WHAT I DO</h2>
        </header>
        <div class="interest-list">
          <article><h3>Cybersecurity</h3><p>정보보안 공부</p></article>
          <article><h3>Linux</h3><p>리눅스 공부 및 실습</p></article>
          <article><h3>Wargame</h3><p>워게임 문제 풀기</p></article>
        </div>
      </section>

      <section class="about-section" aria-labelledby="favorite-anime">
        <header class="section-heading">
          <span>02</span>
          <h2 id="favorite-anime">FAVORITE ANIME</h2>
        </header>
        <div class="anime-grid">
          <article class="anime-item">
            <div class="anime-art"><img src={rootUrl('images/anime-bocchi-the-rock.png')} alt="봇치 더 록 공식 비주얼" width="1200" height="630" /></div>
            <h3 lang="ja">ぼっち・ざ・ろっく！</h3>
            <p>Bocchi the Rock!</p>
          </article>
          <article class="anime-item">
            <div class="anime-art anime-art-date"><img src={rootUrl('images/anime-date-a-live.jpg')} alt="데이트 어 라이브 V 공식 키 비주얼" width="1920" height="2717" /></div>
            <h3 lang="ja">デート・ア・ライブ</h3>
            <p>Date A Live</p>
          </article>
        </div>
      </section>

      <section class="about-section links-section" aria-labelledby="about-links">
        <header class="section-heading">
          <span>03</span>
          <h2 id="about-links">LINKS</h2>
        </header>
        <nav class="about-links" aria-label="aviniy 링크">
          <a href="https://github.com/aviniy" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
          <a href="https://www.instagram.com/aviniyy/" target="_blank" rel="noopener noreferrer">Instagram <span>↗</span></a>
          <button id="about-discord" type="button">Discord <span>@aviniyy</span></button>
          <a href={rootUrl('lab/')}>Aviniy's Lab <span>→</span></a>
        </nav>
        <p id="about-link-status" class="sr-status" aria-live="polite"></p>
      </section>
    </div>
  </main>
  <script is:inline>
    const discord=document.querySelector('#about-discord'),status=document.querySelector('#about-link-status');discord?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('@aviniyy');status.textContent='Discord @aviniyy 복사됨'}catch{status.textContent='Discord · @aviniyy'}setTimeout(()=>status.textContent='',1800)});
  </script>
</PersonalLayout>
