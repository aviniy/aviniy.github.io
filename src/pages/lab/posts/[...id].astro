---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import * as cheerio from 'cheerio';
import { allPosts, date, url } from '../../../lib/posts.js';
export async function getStaticPaths(){return (await allPosts()).map(post=>({params:{id:post.id},props:{post}}))}
const { post } = Astro.props;
const posts = await allPosts();
const { Content, headings } = await render(post);
const imported = cheerio.load(post.body || '');
const importedHeadings = imported('h2,h3').map((_,el)=>({depth:Number(el.tagName.slice(1)),slug:imported(el).attr('id'),text:imported(el).text()})).get();
const toc = (headings.length ? headings : importedHeadings).filter(h=>h.depth===2 || h.depth===3);
---
<BaseLayout title={`${post.data.title} · Aviniy's Lab`} description={post.data.description} posts={posts}><div class="article-layout"><article><div class="breadcrumbs"><a href={url()}>Home</a> / <a href={url(`category/${encodeURIComponent(post.data.category)}/`)}>{post.data.category}</a></div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-meta"><span>{post.data.category}</span><span>작성 {date(post.data.createdAt)}</span><span>수정 {date(post.data.updatedAt)}</span>{post.data.tags.map(t=><span class="tag">#{t}</span>)}</div>{toc.length>0 && <details class="mobile-toc"><summary>목차</summary><nav>{toc.map(h=><a class:list={[{indent:h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>)}</nav></details>}<div class="prose"><Content /></div></article>{toc.length>0 && <aside class="toc"><div class="toc-title">ON THIS PAGE</div><nav aria-label="목차">{toc.map(h=><a class:list={[{indent:h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>)}</nav></aside>}</div><dialog id="image-dialog" aria-label="이미지 확대"><button type="button" aria-label="닫기">×</button><img alt=""/></dialog><script is:inline>document.querySelectorAll('.prose pre').forEach(pre=>{const b=document.createElement('button');b.className='copy';b.type='button';b.textContent='Copy';b.addEventListener('click',async()=>{await navigator.clipboard.writeText(pre.querySelector('code')?.innerText||pre.innerText);b.textContent='Copied';setTimeout(()=>b.textContent='Copy',1500)});pre.append(b)});const dialog=document.querySelector('#image-dialog');document.querySelectorAll('.prose img').forEach(img=>{img.tabIndex=0;img.addEventListener('click',()=>{dialog.querySelector('img').src=img.src;dialog.querySelector('img').alt=img.alt;dialog.showModal()});img.addEventListener('keydown',e=>{if(e.key==='Enter')img.click()})});dialog.querySelector('button').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});document.querySelectorAll('.prose a[href^="http"]').forEach(a=>{a.target='_blank';a.rel='noopener noreferrer'});</script></BaseLayout>
