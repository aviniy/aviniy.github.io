---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { allPosts, url } from '../../lib/posts.js';
import { categories, categoryMatches } from '../../config/categories.js';
const posts = await allPosts();
---
<BaseLayout posts={posts}><div class="eyebrow">PERSONAL KNOWLEDGE BASE</div><h1>Aviniy's Lab</h1><p class="subtitle">Security Research &amp; Study Notes</p><p class="intro">정보보안, 리눅스, 웹 보안, 워게임 등을 공부하고 기록하는 개인 연구 공간.</p><section><h2>Recently Updated</h2><PostList posts={posts.slice(0,5)}/></section><section><h2>Categories</h2><div class="category-grid">{categories.map(c => <a href={url(`category/${encodeURIComponent(c.name)}/`)}><strong>{c.name}</strong><span>{posts.filter(p=>categoryMatches(p.data.category,c.name)).length} posts →</span></a>)}</div></section><section><h2>All Posts</h2><PostList posts={posts}/></section></BaseLayout>
