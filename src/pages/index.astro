---
import PersonalLayout from '../layouts/PersonalLayout.astro';
import YouTubeMusicPlayer from '../components/YouTubeMusicPlayer.astro';
import { youtubePlaylist } from '../config/youtubePlaylist.js';
import { rootUrl } from '../lib/posts.js';
---
<PersonalLayout>
  <main class="home" style={`--hero:url('${rootUrl('images/bocchi-the-rock-hd.png')}')`}>
    <div class="shade"></div>
    <header class="topbar">
      <a class="logo" href={rootUrl()}>AVINIY<span>✦</span></a>
      <a class="lab-link" href={rootUrl('lab/')}>LAB ↗</a>
    </header>

    <div class="home-layout">
      <div class="home-left">
        <section class="hero-copy">
          <p class="kicker">PERSONAL SPACE · SEOUL</p>
          <h1>Welcome to<br/><em>Aviniy's Space</em></h1>
          <p class="intro">관심 있는 것을 깊게 파고들고, 만들고, 기록합니다.<br/>보안·개발·디자인과 애니메이션을 좋아하는 Aviniy의 개인 공간입니다.</p>
          <a class="enter" href={rootUrl('lab/')}><span>기술 블로그 들어가기</span><b>→</b></a>
        </section>

        <aside class="info" aria-label="홈페이지 정보">
          <section class="info-row clock" aria-live="polite"><div><span>SEOUL TIME</span><strong id="seoul-time">--:--:--</strong></div><small id="seoul-date">KST</small></section>
          <section class="info-row note"><span>RANDOM NOTE</span><p id="random-message">좋아하는 것을 오래 기록하면 결국 나만의 지도가 된다.</p><button id="shuffle-message" type="button" aria-label="다른 랜덤 문장">↻</button></section>
        </aside>

        <nav class="social-dock" aria-label="소셜 링크">
      <a href="https://github.com/aviniy" target="_blank" rel="noopener noreferrer" aria-label="GitHub @aviniy" data-label="GitHub · @aviniy"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a>
      <a href="https://www.instagram.com/aviniyy/" target="_blank" rel="noopener noreferrer" aria-label="Instagram @aviniyy" data-label="Instagram · @aviniyy"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle class="fill" cx="17.4" cy="6.7" r="1.1"/></svg></a>
      <button id="copy-discord" type="button" aria-label="Discord 사용자명 @aviniyy 복사" data-label="Discord · @aviniyy"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 7.4a14 14 0 0 1 9.6 0c1.5 2.2 2.2 4.6 2.1 7.1a12 12 0 0 1-3.1 1.9l-.8-1.1c.6-.2 1.1-.5 1.6-.9-3 1.4-6.2 1.4-9.2 0 .5.4 1 .7 1.6.9l-.8 1.1a12 12 0 0 1-3.1-1.9c-.1-2.5.6-4.9 2.1-7.1Z"/><circle class="cut" cx="9.2" cy="12" r="1.25"/><circle class="cut" cx="14.8" cy="12" r="1.25"/></svg></button>
      <a href={rootUrl('lab/')} aria-label="Aviniy's Lab" data-label="Aviniy's Lab"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3h6M10 3v5l-5.4 9.1A2.6 2.6 0 0 0 6.8 21h10.4a2.6 2.6 0 0 0 2.2-3.9L14 8V3"/><path d="M7.4 16h9.2"/></svg></a>
          <span id="social-status" aria-live="polite"></span>
        </nav>
      </div>

      <YouTubeMusicPlayer playlist={youtubePlaylist} />
    </div>

    <footer><span>© 2026 AVINIY</span><span>結束バンド · BOCCHI THE ROCK!</span></footer>
  </main>
  <script is:inline>
    const messages=['좋아하는 것을 오래 기록하면 결국 나만의 지도가 된다.','오늘의 작은 호기심이 내일의 프로젝트가 된다.','천천히, 하지만 멈추지 않고.','좋은 기록은 다시 시작할 수 있는 체크포인트다.','완벽함보다 계속 만드는 쪽을 선택한다.'];const message=document.querySelector('#random-message');function shuffle(){let next=messages[Math.floor(Math.random()*messages.length)];if(next===message.textContent)next=messages[(messages.indexOf(next)+1)%messages.length];message.textContent=next}document.querySelector('#shuffle-message')?.addEventListener('click',shuffle);shuffle();const time=document.querySelector('#seoul-time'),date=document.querySelector('#seoul-date');function tick(){const now=new Date();time.textContent=new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(now);date.textContent=new Intl.DateTimeFormat('ko-KR',{timeZone:'Asia/Seoul',month:'short',day:'numeric',weekday:'short'}).format(now)+' · KST'}tick();setInterval(tick,1000);const discord=document.querySelector('#copy-discord'),status=document.querySelector('#social-status');discord?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('@aviniyy');status.textContent='Discord @aviniyy 복사됨'}catch{status.textContent='Discord · @aviniyy'}setTimeout(()=>status.textContent='',1800)});
  </script>
</PersonalLayout>
